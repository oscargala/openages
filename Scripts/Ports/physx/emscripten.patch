--- a/physx/source/compiler/cmake/linux/CMakeLists.txt
+++ b/physx/source/compiler/cmake/linux/CMakeLists.txt
@@ -43,6 +43,12 @@
        ENDIF()
 ENDIF()
 
+# Emscripten (wasm32) uses the Linux preset. wasm has no SSE2 unless built with
+# -msimd128 -msse2, so PhysX's scalar math path is selected explicitly.
+IF (EMSCRIPTEN)
+	STRING(APPEND PHYSX_CXX_FLAGS " -DPX_SIMD_DISABLED")
+ENDIF()
+
 # Build debug info for all configurations
 SET(PHYSX_CXX_FLAGS_DEBUG   "-O0 -g3 -gdwarf-2" CACHE INTERNAL "PhysX Debug CXX Flags")
 SET(PHYSX_CXX_FLAGS_CHECKED "-O3 -g3 -gdwarf-2" CACHE INTERNAL "PhysX Checked CXX Flags")
@@ -63,7 +69,7 @@
 # Controls PX_NVTX for all projects
 SET(NVTX_FLAG "PX_NVTX=0")
 
-IF(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
+IF(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64" OR EMSCRIPTEN)
 	SET(CUDA_FLAG "DISABLE_CUDA_PHYSX")
 ENDIF()
 
